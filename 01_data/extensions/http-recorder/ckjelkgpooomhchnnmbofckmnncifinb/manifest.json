{
  "manifest_version": 3,
  "name": "HTTP Traffic and Cookie Recorder",
  "version": "2.0",
  "description": "Record HTTP Traffic and Cookies - MV3 Edition",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "jquery-3.7.1.min.js",
        "jquery.csv.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}